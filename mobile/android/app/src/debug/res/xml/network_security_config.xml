<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG builds only. Overrides the strict main config (same resource name) so a
  physical device can talk to a backend running on your machine over plain HTTP
  at its LAN IP (e.g. http://192.168.x.x:8080). Release builds keep the strict
  HTTPS-only policy from src/main/res/xml/network_security_config.xml.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
