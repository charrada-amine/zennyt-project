# Docker Compose local development defaults
POSTGRES_DB=zennyt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
BACKEND_PORT=8080

JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D

# Comma-separated OAuth/OIDC audiences accepted by the backend.
# Google: web, Android, and iOS OAuth client IDs as needed.
GOOGLE_CLIENT_IDS=
# Apple: Services ID and/or application bundle ID as needed.
APPLE_CLIENT_IDS=

# Cloudinary — stockage des fichiers téléversés : CV, avatars, logos (couche infrastructure).
# cloud-name = nom du compte/account name, plus la clé et le secret API.
CLOUDINARY_CLOUD_NAME=dbkxffjgd
CLOUDINARY_API_KEY=816956116244257
CLOUDINARY_API_SECRET=SisHNefg-FelZA_WM_AG7UdbrQk

# Resend — envoi d'e-mails transactionnels (code OTP de réinitialisation de mot de passe).
# RESEND_FROM_EMAIL doit utiliser un domaine vérifié dans Resend, ex. "Zennyt <no-reply@mondomaine.com>".
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Durée de validité du code OTP (format ISO-8601, défaut 10 min).
PASSWORD_RESET_CODE_TTL=PT10M
RESEND_FROM_EMAIL=onboarding@resend.dev
