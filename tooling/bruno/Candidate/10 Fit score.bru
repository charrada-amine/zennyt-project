meta {
  name: 10 Fit score
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/fit-scores?candidateId={{candidateId}}&jobOfferId={{offer1}}
  body: none
  auth: none
}

params:query {
  candidateId: {{candidateId}}
  jobOfferId: {{offer1}}
}

headers {
  X-Dev-User: {{candidateId}}
}

docs {
  Score de compatibilite IA candidat<->offre. Un score de 87 est seede pour
  candidateId + offer1.
}
