meta {
  name: 08 Submit assessment attempt
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/assessment-attempts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User: {{candidateId}}
}

body:json {
  {
    "assessmentId": "{{assessment1}}",
    "jobOfferId": "{{offer1}}",
    "answers": [1, 0]
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("attemptId", res.body.id);
  }
}

docs {
  Le candidat passe l'evaluation seedee (assessment1). answers = index choisi par
  question. Les bonnes reponses seedees sont [1, 0] -> score 100. attemptId est capture.
  Un candidat ne peut passer qu'une fois ce test pour cette offre.
}
