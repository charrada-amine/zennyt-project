meta {
  name: 01 Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "candidate1@zennyt.com",
    "password": "1234"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("accessToken", res.body.accessToken);
    bru.setVar("refreshToken", res.body.refreshToken);
  }
}

docs {
  200 → { accessToken, refreshToken, tokenType: "Bearer", expiresIn } —
  même contrat que l'équipe Identity. Comptes seedés (mdp 1234) :
  recruiter1@, recruiter2@, candidate1@, candidate2@, candidate3@ …@zennyt.com.
  401 si mauvais mot de passe.
}
