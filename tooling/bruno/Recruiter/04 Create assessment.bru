meta {
  name: 04 Create assessment
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/assessments
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User: {{recruiterId}}
}

body:json {
  {
    "title": "Test technique back-end",
    "questions": [
      {
        "text": "Quel outil est un systeme de controle de version ?",
        "options": ["Docker", "Git", "Jenkins", "Node.js"],
        "correctOptionIndex": 1
      },
      {
        "text": "Quel langage tourne sur la JVM ?",
        "options": ["Java", "Python", "Ruby", "Go"],
        "correctOptionIndex": 0
      }
    ]
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("createdAssessmentId", res.body.id);
  }
}

docs {
  Cree une evaluation MCQ. Chaque question doit avoir exactement 4 options
  et un correctOptionIndex entre 0 et 3.
}
