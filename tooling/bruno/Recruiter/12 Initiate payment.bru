meta {
  name: 12 Initiate payment
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/payments
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User: {{recruiterId}}
}

body:json {
  {
    "candidateId": "{{candidateId}}",
    "matchId": "{{matchId}}",
    "cardLast4": "4242",
    "cardType": "VISA"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("paymentId", res.body.id);
  }
}

docs {
  Paiement visio (9.99 EUR + taxe). Necessite matchId : le match doit exister, donc
  lancez d'abord les DEUX swipes (Candidate -> 04 Swipe offer ET Recruiter -> 08
  Swipe candidate) — le second capture matchId. Le statut passe a OTP_SENT.
}
