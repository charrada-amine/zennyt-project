meta {
  name: 13 Verify payment OTP
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/v1/payments/{{paymentId}}/verify-otp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User: {{recruiterId}}
}

body:json {
  {
    "otpCode": "12345"
  }
}

docs {
  Confirme le paiement via OTP. En dev, n'importe quel code fonctionne
  (la validation OTP reelle est deleguee a un service externe). Statut -> CONFIRMED.
}
