meta {
  name: 14 Assessment results for offer
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/v1/assessment-attempts?jobOfferId={{offer1}}
  body: none
  auth: none
}

params:query {
  jobOfferId: {{offer1}}
}

headers {
  X-Dev-User: {{recruiterId}}
}

docs {
  Resultats des tentatives d'evaluation pour l'offre offer1. Le candidat doit
  d'abord soumettre une tentative (Candidate -> Submit assessment attempt).
}
