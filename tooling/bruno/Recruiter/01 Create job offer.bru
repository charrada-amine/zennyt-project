meta {
  name: 01 Create job offer
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/job-offers
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User: {{recruiterId}}
}

body:json {
  {
    "title": "Data Engineer",
    "description": "Pipelines de donnees et entrepot analytique.",
    "contractType": "FULL_TIME",
    "workplaceType": "HYBRID",
    "experienceLevel": "SENIOR",
    "city": "Tunis",
    "country": "TN",
    "remote": false
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("createdOfferId", res.body.id);
  }
}

docs {
  Cree une offre. Elle demarre en statut DRAFT (invisible dans le feed candidat).
  L'id est capture dans la variable createdOfferId pour les requetes suivantes.
}
