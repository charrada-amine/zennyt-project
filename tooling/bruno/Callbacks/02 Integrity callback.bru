meta {
  name: 02 Integrity callback
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/callbacks/integrity
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Callback-Secret: {{callbackSecret}}
}

body:json {
  {
    "attemptId": "{{attemptId}}",
    "status": "VALIDATED"
  }
}

docs {
  Simule le service anti-fraude qui valide une tentative d'evaluation.
  Necessite attemptId (Candidate -> Submit assessment attempt).
  Statuts : PENDING / VALIDATED / NOT_VALIDATED.
}
