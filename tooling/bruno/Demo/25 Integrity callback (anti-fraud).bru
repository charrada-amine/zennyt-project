meta {
  name: 25 Integrity callback (anti-fraud)
  type: http
  seq: 28
}

post {
  url: {{baseUrl}}/api/v1/callbacks/integrity
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Callback-Secret: {{callbackSecret}}
}

body:json {
  {
    "attemptId": "{{attemptId}}",
    "status": "VALIDATED"
  }
}

docs {
  Le service anti-fraude valide la tentative de test (intégrité OK).
}
