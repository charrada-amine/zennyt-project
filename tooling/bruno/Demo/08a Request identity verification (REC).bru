meta {
  name: 08a Request identity verification (REC)
  type: http
  seq: 59
}

post {
  url: {{baseUrl}}/api/v1/identity-verifications
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{recruiterToken}}
}

body:json {
  {
    "candidateId": "{{candidateId}}",
    "jobOfferId": "{{demoOfferId}}"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("demoVerificationId", res.body.id);
  }
}

docs {
  Le recruteur demande une vérification d'identité anti-fraude (facial) pour
  Aicha sur son offre → status PENDING.
}
