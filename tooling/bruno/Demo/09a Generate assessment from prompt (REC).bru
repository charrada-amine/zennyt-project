meta {
  name: 09a Generate assessment from prompt (REC)
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/api/v1/assessments/generate/from-prompt
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{recruiterToken}}
}

body:json {
  {
    "jobDescription": "Backend engineer, Spring Boot + PostgreSQL, owns the recruitment matching API.",
    "questionCount": 3
  }
}

assert {
  res.status: eq 201
  res.body.questions: length 3
  res.body.shareableLink: isDefined
}

docs {
  Nouveau (20/07) : génère un QCM par IA (Groq) à partir d'une description
  libre du poste — pas besoin de rédiger les questions à la main. Même port
  hexagonal que le fit-score (AssessmentGeneratorPort, Groq + stub offline).

  Corrige au passage un bug latent : Assessment.createFromGeneration
  n'écrivait jamais shareableLink (seul createManual le faisait) — vérifiable
  ici, le champ est bien renseigné.
}
