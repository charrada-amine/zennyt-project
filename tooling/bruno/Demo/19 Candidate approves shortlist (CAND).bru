meta {
  name: 19 Candidate approves shortlist (CAND)
  type: http
  seq: 29
}

patch {
  url: {{baseUrl}}/api/v1/applications/{{appId}}/respond
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{candidateToken}}
}

body:json {
  {
    "approve": true
  }
}

assert {
  res.status: eq 200
  res.body.status: eq APPROVED
}

docs {
  Nouveau endpoint (20/07) : le candidat répond à sa présélection.
  Machine à états : SHORTLISTED -> APPROVED (approve:false rejetterait).
  Contrepartie candidat de RespondToShortlistUseCase — voir "18a" pour le
  garde-fou qui empêche le recruteur de faire ce pas à sa place.
}
