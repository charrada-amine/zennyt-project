meta {
  name: 00 Login Rania (REC)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "recruiter1@zennyt.com",
    "password": "zennyt123"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("recruiterToken", res.body.accessToken);
  }
}

docs {
  Login recruteur (Rania) — vrai JWT (contrat aligné squad Identity). Toutes
  les requêtes REC de cette collection portent {{recruiterToken}} en Bearer.
}
