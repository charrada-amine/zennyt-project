meta {
  name: 03 Update offer partially (REC)
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/api/v1/job-offers/{{demoOfferId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{recruiterToken}}
}

body:json {
  {
    "companyName": "Zennyt Inc.",
    "salaryMin": 3000,
    "salaryMax": 5000,
    "currency": "USD"
  }
}

docs {
  PATCH partiel : seuls les champs envoyés changent, le reste est conservé.
  (Les offres sont créées directement en ACTIVE — plus besoin d'étape d'activation.
  Pour masquer/fermer : PATCH /job-offers/{id}/status avec HIDDEN ou CLOSED.)
}
