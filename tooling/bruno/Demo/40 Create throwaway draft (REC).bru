meta {
  name: 40 Create throwaway draft (REC)
  type: http
  seq: 52
}

post {
  url: {{baseUrl}}/api/v1/job-offers
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{recruiterToken}}
}

body:json {
  {
    "title": "Offre jetable (à supprimer)",
    "description": "Sert à démontrer la suppression.",
    "contractType": "CONTRACT",
    "workplaceType": "ON_SITE",
    "experienceLevel": "JUNIOR",
    "city": "Sfax",
    "country": "TN",
    "remote": false
  }
}

script:post-response {
  if (res.status === 201) { bru.setVar("throwawayOfferId", res.body.id); }
}

docs {
  Offre créée (ACTIVE) uniquement pour démontrer la suppression (requête suivante).
}
