meta {
  name: 27 Request identity verification (REC)
  type: http
  seq: 30
}

post {
  url: {{baseUrl}}/api/v1/identity-verifications
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{recruiterToken}}
}

body:json {
  {
    "candidateId": "{{candidateId}}",
    "jobOfferId": "{{demoOfferId}}"
  }
}

script:post-response {
  if (res.status === 201) { bru.setVar("verifId", res.body.id); }
}
