meta {
  name: 49 Callback wrong secret 401 (AI)
  type: http
  seq: 61
}

post {
  url: {{baseUrl}}/api/v1/callbacks/fit-score
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Callback-Secret: mauvais-secret
}

body:json {
  {
    "candidateId": "{{candidateId}}",
    "jobOfferId": "{{offer1}}",
    "score": 99
  }
}

assert {
  res.status: eq 401
}

docs {
  Test négatif : un secret invalide est refusé (401) — le TODO « valider le
  secret » est enfin fermé, plus personne ne peut forger des fit scores.
}
