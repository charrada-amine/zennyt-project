meta {
  name: 11a Callback wrong secret 401 (AI)
  type: http
  seq: 78
}

post {
  url: {{baseUrl}}/api/v1/callbacks/fit-score
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Callback-Secret: not-the-real-secret
}

body:json {
  {
    "candidateId": "{{candidateId}}",
    "jobOfferId": "{{demoOfferId}}",
    "score": 99
  }
}

docs {
  Un secret invalide ne peut plus forger de scores (ou de résultats
  d'identité) → 401. Les callbacks tiers sont protégés par
  X-Callback-Secret, jamais par un JWT.
}
