meta {
  name: 29 Identity callback (facial)
  type: http
  seq: 32
}

post {
  url: {{baseUrl}}/api/v1/callbacks/identity-verification
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Callback-Secret: {{callbackSecret}}
}

body:json {
  {
    "verificationId": "{{verifId}}",
    "status": "COMPLETED_SUCCESS"
  }
}

docs {
  Le service de reconnaissance faciale renvoie le résultat de la vérification.
}
