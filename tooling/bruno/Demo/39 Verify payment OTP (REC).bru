meta {
  name: 39 Verify payment OTP (REC)
  type: http
  seq: 42
}

post {
  url: {{baseUrl}}/api/v1/payments/{{payId}}/verify-otp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{recruiterToken}}
}

body:json {
  {
    "otpCode": "12345"
  }
}

docs {
  Confirme le paiement. Statut -> CONFIRMED, otpVerified -> true.
}
