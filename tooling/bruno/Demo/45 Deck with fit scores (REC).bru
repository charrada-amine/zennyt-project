meta {
  name: 45 Deck with fit scores (REC)
  type: http
  seq: 57
}

get {
  url: {{baseUrl}}/api/v1/recruiters/me/candidate-feed?jobOfferId={{offer2}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{recruiterToken}}
}

assert {
  res.status: eq 200
  res.body.content[0].fitScore: isDefined
}

script:post-response {
  const deck = res.body.content;
  for (let i = 1; i < deck.length; i++) {
    if (deck[i].fitScore > deck[i - 1].fitScore) {
      throw new Error("Deck non trié par fit score décroissant");
    }
  }
}

docs {
  Deck recruteur pour l'offre 2 (route intégrée : /recruiters/me/candidate-feed,
  enveloppe { content, page }) : chaque carte porte le vrai score de la paire
  (candidat × offre), trié décroissant.
}
