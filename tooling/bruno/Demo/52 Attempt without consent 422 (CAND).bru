meta {
  name: 52 Attempt without consent 422 (CAND)
  type: http
  seq: 64
}

post {
  url: {{baseUrl}}/api/v1/assessment-attempts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{candidateToken}}
}

body:json {
  {
    "assessmentId": "{{assessment1}}",
    "jobOfferId": "{{offer1}}",
    "answers": [1, 0],
    "monitoringConsent": false
  }
}

assert {
  res.status: eq 422
}

docs {
  Test négatif : sans consentement à la surveillance anti-fraude (case du
  mockup « I agree to security monitoring »), la tentative est refusée (422)
  avant toute écriture.
}
