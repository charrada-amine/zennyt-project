meta {
  name: 20 Submit assessment attempt (CAND)
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/api/v1/assessment-attempts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{candidateToken}}
}

body:json {
  {
    "assessmentId": "{{demoAssessmentId}}",
    "jobOfferId": "{{demoOfferId}}",
    "answers": [1, 0],
    "monitoringConsent": true
  }
}

assert {
  res.status: eq 201
  res.body.applicationId: isDefined
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("attemptId", res.body.id);
    bru.setVar("attemptApplicationId", res.body.applicationId);
  }
}

docs {
  Réponses [1,0] = les bonnes → score 100. La tentative EST la candidature
  (cadrage 16/07) : la réponse porte l'applicationId (ici celui créé en 14 —
  rejoint, pas dupliqué). monitoringConsent obligatoire (422 sinon, cf. 52).
}
