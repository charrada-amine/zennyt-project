meta {
  name: 53 Opportunity ghost candidate 404 (REC)
  type: http
  seq: 65
}

post {
  url: {{baseUrl}}/api/v1/job-opportunity-offers
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{recruiterToken}}
}

body:json {
  {
    "candidateId": "99999999-9999-9999-9999-999999999999",
    "jobOfferId": "{{offer1}}"
  }
}

assert {
  res.status: eq 404
}

docs {
  Test négatif : une proposition salariale vers un candidat inexistant est
  refusée (404). Avant le 16/07, send() acceptait n'importe quel candidateId.
}
