meta {
  name: 55 Propose throwaway position (REC)
  type: http
  seq: 67
}

post {
  url: {{baseUrl}}/api/v1/job-positions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{recruiterToken}}
}

body:json {
  {
    "name": "Throwaway Position (Demo {{demoRunId}})",
    "sector": "IT, AI & Fintech"
  }
}

script:pre-request {
  if (!bru.getVar("demoRunId")) { bru.setVar("demoRunId", Date.now()); }
}

script:post-response {
  if (res.status === 201) { bru.setVar("throwawayJobPositionId", res.body.id); }
}

assert {
  res.status: eq 201
}
