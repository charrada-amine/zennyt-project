meta {
  name: 08c Identity callback facial (AI)
  type: http
  seq: 65
}

post {
  url: {{baseUrl}}/api/v1/callbacks/identity-verification
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Callback-Secret: {{callbackSecret}}
}

body:json {
  {
    "verificationId": "{{demoVerificationId}}",
    "status": "COMPLETED_SUCCESS"
  }
}

docs {
  Le service de reconnaissance faciale renvoie le résultat via le secret
  partagé — même mécanisme que le callback fit-score (07a).
}
