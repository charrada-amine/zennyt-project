meta {
  name: 54 Opportunity foreign offer 403 (REC)
  type: http
  seq: 57
}

post {
  url: {{baseUrl}}/api/v1/job-opportunity-offers
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{recruiterToken}}
}

body:json {
  {
    "candidateId": "{{candidateId}}",
    "jobOfferId": "{{offer3}}"
  }
}

assert {
  res.status: eq 403
}

docs {
  Test négatif : Rania ne peut pas envoyer une proposition adossée à l'offre
  de Youssef (403). Le sourcing reste sans précondition métier (pas de match
  ni candidature exigés — cadrage 16/07), mais l'offre doit être la sienne.
}
