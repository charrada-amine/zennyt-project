meta {
  name: 10 Candidate swipes offer (CAND)
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/api/v1/swipes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{candidateToken}}
}

body:json {
  {
    "targetId": "{{demoOfferId}}",
    "targetType": "JOB_OFFER",
    "direction": "LIKE"
  }
}

docs {
  Le candidat like l'offre. matched=false : il manque encore le swipe recruteur.
}
