meta {
  name: 01 Create job offer (REC)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/job-offers
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{recruiterToken}}
}

body:json {
  {
    "title": "Full-Stack Engineer (Demo)",
    "description": "Poste de démonstration créé en direct.",
    "contractType": "FULL_TIME",
    "workplaceType": "HYBRID",
    "experienceLevel": "SENIOR",
    "city": "Tunis",
    "country": "TN",
    "remote": true,
    "jobPositionId": "{{demoJobPositionId}}"
  }
}

script:post-response {
  if (res.status === 201) { bru.setVar("demoOfferId", res.body.id); }
}

assert {
  res.status: eq 201
  res.body.jobPositionId: eq {{demoJobPositionId}}
}

docs {
  jobPositionId (nullable) référence le métier approuvé à l'étape "00d" —
  relie le nouveau référentiel à la création d'offre.
}
