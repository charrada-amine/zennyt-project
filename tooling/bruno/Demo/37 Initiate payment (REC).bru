meta {
  name: 37 Initiate payment (REC)
  type: http
  seq: 40
}

post {
  url: {{baseUrl}}/api/v1/payments
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{recruiterToken}}
}

body:json {
  {
    "candidateId": "{{candidateId}}",
    "matchId": "{{matchId}}",
    "cardLast4": "4242",
    "cardType": "VISA"
  }
}

script:post-response {
  if (res.status === 201) { bru.setVar("payId", res.body.id); }
}

docs {
  Paiement visio (9.99€ + taxe). Nécessite matchId (capturé en 11). Statut -> OTP_SENT.
}
