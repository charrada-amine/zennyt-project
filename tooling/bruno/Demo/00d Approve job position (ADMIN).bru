meta {
  name: 00d Approve job position (ADMIN)
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/api/v1/job-positions/{{demoJobPositionId}}/approve
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{adminToken}}
}

body:json {
  {
    "profileType": "ANALYTIQUE"
  }
}

assert {
  res.status: eq 200
  res.body.status: eq APPROVED
  res.body.profileType: eq ANALYTIQUE
}

docs {
  L'admin assigne le profileType (style RIASEC) à l'approbation. Le métier
  devient visible dans /job-positions et utilisable comme jobPositionId sur
  une offre — voir l'étape "01 Create job offer" juste après.
}
