meta {
  name: 44 Recompute fit scores (REC)
  type: http
  seq: 56
}

post {
  url: {{baseUrl}}/api/v1/fit-scores/recompute
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{recruiterToken}}
}

body:json {
  {
    "jobOfferId": "{{offer2}}"
  }
}

assert {
  res.status: eq 200
  res.body.pairsWritten: gte 1
}

docs {
  Recalcul synchrone des fit scores de l'offre 2 (Flutter) : chaque profil
  connu est scoré par Groq derrière le port FitScoreCalculator (stub hors
  ligne sans clé). Le déclenchement normal est asynchrone (offre activée) —
  cet endpoint est le levier démo déterministe.
}
